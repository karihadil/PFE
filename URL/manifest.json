{
    "manifest_version": 3,
    "name": "Gmail URL Scanner",
    "version": "1.0",
    "description": "Scans the currently opened Gmail email for URLs.",
    "permissions": ["activeTab", "scripting"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/test.png",
        "48": "icons/test.png",
        "128": "icons/test.png"
      }
    },
    "content_scripts": [
      {
        "matches": ["https://mail.google.com/*"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "host_permissions": ["https://mail.google.com/*"]
  }